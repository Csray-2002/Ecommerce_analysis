
import pandas as pd

customers = pd.read_csv("data/raw/olist_customers_dataset.csv")
orders = pd.read_csv("data/raw/olist_orders_dataset.csv")
items = pd.read_csv("data/raw/olist_order_items_dataset.csv")
payments = pd.read_csv("data/raw/olist_order_payments_dataset.csv")
reviews = pd.read_csv("data/raw/olist_order_reviews_dataset.csv")
products = pd.read_csv("data/raw/olist_products_dataset.csv")
sellers = pd.read_csv("data/raw/olist_sellers_dataset.csv")
translations = pd.read_csv("data/raw/product_category_name_translation.csv")

print(orders.shape, orders.isnull().sum ())
print(orders['order_status'].value_counts())


date_cols = ['order_purchase_timestamp', 'order_delivered_customer_date', 'order_estimated_delivery_date']
for col in date_cols:
    orders[col] = pd.to_datetime(orders[col])



orders = orders[orders['order_status'] == 'delivered']
orders = orders.dropna(subset=['order_delivered_customer_date'])

orders["order_month"] = orders["order_purchase_timestamp"].dt.strftime('%Y-%m')
orders["delivery_days"] = (orders["order_delivered_customer_date"] - orders["order_purchase_timestamp"]).dt.days
orders["is_late"] = (orders["order_delivered_customer_date"] > orders["order_estimated_delivery_date"]).astype(int)


reviews = reviews.drop_duplicates(subset=['order_id'], keep='last')

products = products.merge(translations, how='left', on='product_category_name')

products["product_category_name_english"] = products["product_category_name_english"].fillna("unknown")
items["total_price"] = items["price"] +items["freight_value"]

order_value = items.groupby("order_id")["total_price"].sum().reset_index()
order_value = order_value.rename(columns={"total_price": "total_order_value"})

pay = payments.groupby("order_id").agg({
    "payment_value": "sum",
    "payment_installments": "max",
    "payment_type": "first"
}).reset_index()

df = orders.merge(customers, on="customer_id", how="left")
df = df.merge(order_value, on="order_id", how="left")
df = df.merge(pay, on="order_id", how="left")
df = df.merge(reviews[["order_id", "review_score"]], on="order_id", how="left")

order_count = df.groupby("customer_unique_id")["order_id"].nunique()

df["is_repeat"] = (df["customer_unique_id"].map(order_count) > 1).astype(int)

items_clean = items.merge(products[["product_id", 
        "product_category_name"]], how='left', on='product_id')

items_clean = items_clean[items_clean["order_id"].isin(df["order_id"])]

df.to_csv("data/clean/orders_master.csv", index=False)
items_clean.to_csv("data/clean/orders_items_clean.csv", index=False)
customers.to_csv("data/clean/customers_clean.csv", index=False)
products.to_csv("data/clean/products_clean.csv", index=False)
payments.to_csv("data/clean/payments_clean.csv", index=False)
reviews.to_csv("data/clean/reviews_clean.csv", index=False)
sellers.to_csv("data/clean/sellers_clean.csv", index=False)


